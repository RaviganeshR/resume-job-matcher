<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>TalentVector AI Suite</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdn.jsdelivr.net/npm/jspdf@2.5.1/dist/jspdf.umd.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/jspdf-autotable@3.8.2/dist/jspdf.plugin.autotable.min.js"></script>
</head>

<body class="bg-slate-900 text-slate-100 min-h-screen font-sans">
  <div class="max-w-6xl mx-auto px-4 py-8">

    <!-- Platform Header -->
    <header class="flex flex-wrap items-center justify-between border-b border-slate-800 pb-5 mb-6 gap-4">
      <div>
        <h1 class="text-2xl font-bold text-white flex items-center gap-2">
          <span class="w-3 h-3 rounded-full bg-emerald-400 animate-pulse"></span>
          TalentVector AI Suite
        </h1>
        <p class="text-sm text-slate-400 mt-1">
          Intelligent candidate ranking & autonomous resume gap screening
        </p>
      </div>

      <div id="matcherHeaderButtons" class="flex items-center gap-3">
        <button onclick="openUploadModal()"
          class="bg-indigo-600 hover:bg-indigo-500 text-white text-sm font-medium px-4 py-2 rounded-lg transition flex items-center gap-2 shadow-sm">
          <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"></path>
          </svg>
          Upload PDF Resume
        </button>
        <button onclick="openJobModal()"
          class="bg-emerald-600 hover:bg-emerald-500 text-white text-sm font-medium px-4 py-2 rounded-lg transition shadow-sm">
          + Add New JD
        </button>
      </div>
    </header>

    <!-- Navigation Tabs -->
    <div class="flex items-center gap-6 border-b border-slate-800 mb-8">
      <button id="tabMatcherBtn" onclick="switchTab('matcher')"
        class="pb-3 text-sm font-semibold border-b-2 border-emerald-400 text-emerald-400 flex items-center gap-2 transition">
        <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
        1. Semantic Role Matcher
      </button>
      <button id="tabAuditorBtn" onclick="switchTab('auditor')"
        class="pb-3 text-sm font-medium border-b-2 border-transparent text-slate-400 hover:text-slate-200 flex items-center gap-2 transition">
        <span class="w-2 h-2 rounded-full bg-slate-600"></span>
        2. AI Resume Auditor & Question Generator (Use Case 2)
      </button>
    </div>

    <!-- ============================================================= -->
    <!-- TAB 1: SEMANTIC ROLE MATCHER (USE CASE 1)                     -->
    <!-- ============================================================= -->
    <div id="matcherView" class="space-y-8">
      <!-- Target Job Selection -->
      <div class="bg-slate-800/60 border border-slate-700 p-6 rounded-xl">
        <label class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-2">
          Select Target Job Description to Rank Resumes Against:
        </label>
        <select id="jobSelect" onchange="runMatch()"
          class="w-full bg-slate-900 border border-slate-700 rounded-lg p-3 text-white focus:outline-none focus:border-emerald-500">
          <option value="">Loading jobs...</option>
        </select>

        <div id="jobDetails" class="mt-4 p-4 bg-slate-900/60 rounded-lg border border-slate-800 hidden">
          <h3 id="jobTitleDisplay" class="font-semibold text-emerald-400 text-base"></h3>
          <p id="jobSkillsDisplay" class="text-xs text-slate-400 mt-1"></p>
          <p id="jobSummaryDisplay" class="text-sm text-slate-300 mt-2"></p>
        </div>
      </div>

      <!-- Ranked List Controls -->
      <div>
        <div class="flex flex-wrap items-center justify-between mb-4 gap-3">
          <div>
            <h2 class="text-lg font-semibold text-white">
              Ranked Candidate Profiles
            </h2>
            <span id="candidateCount" class="text-xs text-slate-500"></span>
          </div>

          <div class="flex items-center gap-2">
            <button onclick="downloadRankedPDF()"
              class="bg-slate-800 hover:bg-slate-700 border border-slate-700 text-slate-200 text-xs font-medium px-3.5 py-1.5 rounded-lg transition flex items-center gap-2 shadow-sm">
              <svg class="w-4 h-4 text-red-400" fill="currentColor" viewBox="0 0 20 20">
                <path
                  d="M4 4a2 2 0 012-2h4.586A2 2 0 0112 2.586L15.414 6A2 2 0 0116 7.414V16a2 2 0 01-2 2H6a2 2 0 01-2-2V4z" />
              </svg>
              Download PDF Report
            </button>
            <span id="matchStatus" class="text-xs text-slate-400 ml-2">Select a job above</span>
          </div>
        </div>

        <div id="resultsContainer" class="space-y-4"></div>
      </div>
    </div>

    <!-- ============================================================= -->
    <!-- TAB 2: AI RESUME AUDITOR & QUESTION GENERATOR (USE CASE 2)    -->
    <!-- ============================================================= -->
    <div id="auditorView" class="hidden space-y-6">
      <!-- Selector Header -->
      <div class="bg-slate-800/60 border border-slate-700 p-6 rounded-xl">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
          <div>
            <h3 class="text-base font-bold text-white">Select a Raw Candidate with Missing Context:</h3>
            <p class="text-xs text-slate-400 mt-1">
              Autonomous inspection for missing dates, unexplained gap years, and buzzword stuffing.
            </p>
          </div>
          <div id="rawCandPills" class="flex flex-wrap gap-2"></div>
        </div>
      </div>

      <!-- Analysis Grid -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <!-- Raw Resume Text Box -->
        <div class="bg-slate-800/80 border border-slate-700 p-5 rounded-xl flex flex-col">
          <div class="flex items-center justify-between mb-3">
            <h4 class="text-xs font-bold text-slate-400 uppercase tracking-wider">Raw Unstructured Resume</h4>
            <span id="rawCandTag"
              class="text-[10px] bg-slate-700 text-slate-300 px-2 py-0.5 rounded font-mono">RAW_01</span>
          </div>
          <div id="flawBanner"
            class="mb-3 p-2.5 bg-amber-950/40 border border-amber-900/60 rounded-lg text-xs text-amber-300 font-medium">
          </div>
          <pre id="rawResumeDisplay"
            class="bg-slate-900 p-4 rounded-lg text-xs text-slate-300 font-mono whitespace-pre-wrap flex-1 overflow-y-auto border border-slate-800 min-h-[350px]">Loading...</pre>
        </div>

        <!-- Agent Findings & Questions -->
        <div class="bg-slate-800/80 border border-slate-700 p-5 rounded-xl flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-4 border-b border-slate-700 pb-3">
              <div>
                <h4 class="text-sm font-bold text-white">Agent Audit Findings</h4>
                <p class="text-xs text-slate-400">Autonomous issue detection & screening question synthesis</p>
              </div>
              <span id="completenessBadge" class="text-xs font-bold px-3 py-1 rounded-full border">Score: --</span>
            </div>

            <!-- Issues Found -->
            <div class="mb-5">
              <h5 class="text-xs font-semibold text-rose-400 uppercase tracking-wider mb-2 flex items-center gap-1.5">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                </svg>
                Detected Missing Information:
              </h5>
              <div id="missingInfoList" class="space-y-2"></div>
            </div>

            <!-- Screening Questions -->
            <div>
              <h5 class="text-xs font-semibold text-indigo-400 uppercase tracking-wider mb-2 flex items-center gap-1.5">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                Generated Candidate Screening Questions:
              </h5>
              <div id="questionsList" class="space-y-2.5"></div>
            </div>
          </div>
        </div>
      </div>
    </div>

  </div>

  <!-- Upload Modal -->
  <div id="uploadModal" class="fixed inset-0 bg-black/75 flex items-center justify-center p-4 hidden z-50">
    <div class="bg-slate-800 border border-slate-700 rounded-xl max-w-lg w-full p-6">
      <div class="flex items-center justify-between mb-2">
        <h3 class="text-lg font-bold text-white flex items-center gap-2">
          <svg class="w-5 h-5 text-red-400" fill="currentColor" viewBox="0 0 20 20">
            <path
              d="M4 4a2 2 0 012-2h4.586A2 2 0 0112 2.586L15.414 6A2 2 0 0116 7.414V16a2 2 0 01-2 2H6a2 2 0 01-2-2V4z" />
          </svg>
          Upload PDF Resume
        </h3>
        <button onclick="closeUploadModal()"
          class="text-slate-400 hover:text-white text-xl leading-none">&times;</button>
      </div>
      <p class="text-xs text-slate-400 mb-4">
        Upload a candidate's PDF file. Content will be parsed locally into the vector space.
      </p>

      <form id="uploadForm" onsubmit="handleResumeUpload(event)" class="space-y-4">
        <div
          class="border-2 border-dashed border-slate-600 hover:border-indigo-500 rounded-xl p-6 text-center transition cursor-pointer"
          onclick="document.getElementById('resumeFileInput').click()">
          <input id="resumeFileInput" type="file" accept="application/pdf,.pdf" class="hidden"
            onchange="updateFileName(this)" required />
          <svg class="w-8 h-8 text-indigo-400 mx-auto mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"></path>
          </svg>
          <span id="selectedFileLabel" class="text-sm text-slate-300">Choose a .pdf file</span>
        </div>

        <div>
          <label class="block text-xs text-slate-400 mb-1">Candidate Name (Optional)</label>
          <input id="uploadName" type="text" placeholder="e.g., Alex Johnson"
            class="w-full bg-slate-900 border border-slate-700 rounded p-2 text-sm text-white focus:outline-none focus:border-indigo-500" />
        </div>
        <div>
          <label class="block text-xs text-slate-400 mb-1">Current Job Title (Optional)</label>
          <input id="uploadTitle" type="text" placeholder="e.g., Senior Systems Engineer"
            class="w-full bg-slate-900 border border-slate-700 rounded p-2 text-sm text-white focus:outline-none focus:border-indigo-500" />
        </div>

        <div class="flex justify-end gap-3 pt-2">
          <button type="button" onclick="closeUploadModal()"
            class="px-4 py-2 rounded text-slate-400 hover:text-white text-sm">Cancel</button>
          <button id="uploadSubmitBtn" type="submit"
            class="bg-indigo-600 hover:bg-indigo-500 px-4 py-2 rounded text-white text-sm font-medium">Extract &
            Ingest</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Edit Candidate Modal -->
  <div id="editModal" class="fixed inset-0 bg-black/75 flex items-center justify-center p-4 hidden z-50">
    <div class="bg-slate-800 border border-slate-700 rounded-xl max-w-lg w-full p-6">
      <h3 class="text-lg font-bold text-white mb-4">Edit Candidate Profile</h3>
      <input type="hidden" id="editCandId" />
      <div class="space-y-4">
        <div>
          <label class="block text-xs text-slate-400 mb-1">Full Name</label>
          <input id="editName" type="text"
            class="w-full bg-slate-900 border border-slate-700 rounded p-2 text-sm text-white focus:outline-none focus:border-indigo-500" />
        </div>
        <div>
          <label class="block text-xs text-slate-400 mb-1">Current / Target Title</label>
          <input id="editTitle" type="text"
            class="w-full bg-slate-900 border border-slate-700 rounded p-2 text-sm text-white focus:outline-none focus:border-indigo-500" />
        </div>
        <div>
          <label class="block text-xs text-slate-400 mb-1">Skills (comma separated)</label>
          <input id="editSkills" type="text"
            class="w-full bg-slate-900 border border-slate-700 rounded p-2 text-sm text-white focus:outline-none focus:border-indigo-500" />
        </div>
        <div>
          <label class="block text-xs text-slate-400 mb-1">Summary / Experience</label>
          <textarea id="editSummary" rows="4"
            class="w-full bg-slate-900 border border-slate-700 rounded p-2 text-sm text-white focus:outline-none focus:border-indigo-500"></textarea>
        </div>
      </div>
      <div class="flex justify-end gap-3 mt-6">
        <button onclick="closeEditModal()"
          class="px-4 py-2 rounded text-slate-400 hover:text-white text-sm">Cancel</button>
        <button onclick="saveCandidateEdit()"
          class="bg-indigo-600 hover:bg-indigo-500 px-4 py-2 rounded text-white text-sm font-medium">Save
          Changes</button>
      </div>
    </div>
  </div>

  <!-- Add Job Modal -->
  <div id="jobModal" class="fixed inset-0 bg-black/75 flex items-center justify-center p-4 hidden z-50">
    <div class="bg-slate-800 border border-slate-700 rounded-xl max-w-lg w-full p-6">
      <h3 class="text-lg font-bold text-white mb-4">Add New Job Description</h3>
      <div class="space-y-4">
        <div>
          <label class="block text-xs text-slate-400 mb-1">Job ID</label>
          <input id="newId" type="text" placeholder="e.g., JD21"
            class="w-full bg-slate-900 border border-slate-700 rounded p-2 text-sm text-white focus:outline-none focus:border-emerald-500" />
        </div>
        <div>
          <label class="block text-xs text-slate-400 mb-1">Job Title</label>
          <input id="newTitle" type="text" placeholder="e.g., Cloud Architect"
            class="w-full bg-slate-900 border border-slate-700 rounded p-2 text-sm text-white focus:outline-none focus:border-emerald-500" />
        </div>
        <div>
          <label class="block text-xs text-slate-400 mb-1">Required Skills</label>
          <input id="newSkills" type="text" placeholder="AWS, Terraform, Kubernetes"
            class="w-full bg-slate-900 border border-slate-700 rounded p-2 text-sm text-white focus:outline-none focus:border-emerald-500" />
        </div>
        <div>
          <label class="block text-xs text-slate-400 mb-1">Role Summary</label>
          <textarea id="newSummary" rows="3" placeholder="Lead cloud architecture..."
            class="w-full bg-slate-900 border border-slate-700 rounded p-2 text-sm text-white focus:outline-none focus:border-emerald-500"></textarea>
        </div>
      </div>
      <div class="flex justify-end gap-3 mt-6">
        <button onclick="closeJobModal()"
          class="px-4 py-2 rounded text-slate-400 hover:text-white text-sm">Cancel</button>
        <button onclick="submitNewJob()"
          class="bg-emerald-600 hover:bg-emerald-500 px-4 py-2 rounded text-white text-sm font-medium">Save
          Opening</button>
      </div>
    </div>
  </div>

  <script>
    let allJobs = [];
    let currentRankings = [];
    let rawResumes = [];

    async function init() {
      const res = await fetch("/api/data");
      const data = await res.json();
      allJobs = data.jobs;

      const select = document.getElementById("jobSelect");
      select.innerHTML = allJobs.map(j => `<option value="${j.id}">${j.title} (${j.id})</option>`).join("");

      if (allJobs.length > 0) {
        runMatch();
      }
    }

    // --- TAB SWITCHER LOGIC ---
    function switchTab(tab) {
      const matcherView = document.getElementById('matcherView');
      const auditorView = document.getElementById('auditorView');
      const tabMatcherBtn = document.getElementById('tabMatcherBtn');
      const tabAuditorBtn = document.getElementById('tabAuditorBtn');
      const headerBtns = document.getElementById('matcherHeaderButtons');

      if (tab === 'matcher') {
        matcherView.classList.remove('hidden');
        auditorView.classList.add('hidden');
        headerBtns.classList.remove('hidden');

        tabMatcherBtn.className = 'pb-3 text-sm font-semibold border-b-2 border-emerald-400 text-emerald-400 flex items-center gap-2 transition';
        tabAuditorBtn.className = 'pb-3 text-sm font-medium border-b-2 border-transparent text-slate-400 hover:text-slate-200 flex items-center gap-2 transition';
      } else {
        matcherView.classList.add('hidden');
        auditorView.classList.remove('hidden');
        headerBtns.classList.add('hidden');

        tabAuditorBtn.className = 'pb-3 text-sm font-semibold border-b-2 border-indigo-400 text-indigo-400 flex items-center gap-2 transition';
        tabMatcherBtn.className = 'pb-3 text-sm font-medium border-b-2 border-transparent text-slate-400 hover:text-slate-200 flex items-center gap-2 transition';

        loadRawResumes();
      }
    }

    // --- USE CASE 1 FUNCTIONS ---
    async function runMatch() {
      const jobId = document.getElementById("jobSelect").value;
      if (!jobId) return;

      const selected = allJobs.find(j => j.id === jobId);
      if (selected) {
        document.getElementById("jobDetails").classList.remove("hidden");
        document.getElementById("jobTitleDisplay").innerText = `${selected.title} (${selected.id})`;
        document.getElementById("jobSkillsDisplay").innerText = `Skills: ${selected.skills}`;
        document.getElementById("jobSummaryDisplay").innerText = selected.summary;
      }

      document.getElementById("matchStatus").innerText = "Computing vector similarity...";
      const res = await fetch(`/api/match/${jobId}`);
      const data = await res.json();

      currentRankings = data.rankings || [];
      document.getElementById("candidateCount").innerText = `(${currentRankings.length} total profiles)`;
      document.getElementById("matchStatus").innerText = `Ranked against ${selected.title}`;
      renderRankings(currentRankings);
    }

    function renderRankings(rankings) {
      const container = document.getElementById("resultsContainer");
      if (rankings.length === 0) {
        container.innerHTML = `<div class="p-8 text-center text-slate-500 bg-slate-800/40 rounded-xl">No candidates available.</div>`;
        return;
      }

      container.innerHTML = rankings.map((item, idx) => {
        const cand = item.candidate;
        const pct = item.match_percentage;

        let badgeColor = "bg-rose-900/40 text-rose-300 border-rose-800";
        let barColor = "bg-rose-500";
        if (pct >= 80) {
          badgeColor = "bg-emerald-900/40 text-emerald-300 border-emerald-800";
          barColor = "bg-emerald-500";
        } else if (pct >= 60) {
          badgeColor = "bg-indigo-900/40 text-indigo-300 border-indigo-800";
          barColor = "bg-indigo-500";
        } else if (pct >= 45) {
          badgeColor = "bg-amber-900/40 text-amber-300 border-amber-800";
          barColor = "bg-amber-500";
        }

        return `
          <div class="bg-slate-800/80 border border-slate-700 p-5 rounded-xl flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
            <div class="flex items-start gap-4 flex-1">
              <div class="w-9 h-9 rounded-full bg-slate-700 flex items-center justify-center font-bold text-sm text-slate-300 flex-shrink-0">
                #${idx + 1}
              </div>
              <div class="flex-1">
                <div class="flex items-center gap-2 flex-wrap">
                  <h4 class="text-base font-semibold text-white">${cand.name}</h4>
                  <span class="text-xs text-slate-400">· ${cand.current_title}</span>
                  <span class="text-[10px] bg-slate-700 text-slate-400 px-1.5 py-0.5 rounded font-mono">${cand.id}</span>
                </div>
                <p class="text-xs text-slate-400 mt-1"><span class="text-slate-500">Skills:</span> ${cand.skills}</p>
                <p class="text-xs text-slate-300 mt-1 line-clamp-2">${cand.summary}</p>
                
                <div class="flex items-center gap-3 mt-3">
                  <button onclick="openEditModal('${cand.id}')" class="text-xs text-indigo-400 hover:text-indigo-300 flex items-center gap-1 font-medium">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"></path></svg>
                    Edit
                  </button>
                  <button onclick="deleteCandidate('${cand.id}')" class="text-xs text-rose-400 hover:text-rose-300 flex items-center gap-1 font-medium">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                    Delete
                  </button>
                </div>
              </div>
            </div>

            <div class="w-full md:w-56 flex-shrink-0 flex flex-col items-end">
              <div class="flex items-center gap-2 mb-1">
                <span class="text-xs px-2 py-0.5 rounded border ${badgeColor}">${item.verdict}</span>
                <span class="text-lg font-bold text-white">${pct}%</span>
              </div>
              <div class="w-full bg-slate-700 h-1.5 rounded-full overflow-hidden">
                <div class="${barColor} h-full" style="width: ${pct}%"></div>
              </div>
              <span class="text-[10px] text-slate-500 mt-1">Cosine: ${item.raw_cosine}</span>
            </div>
          </div>
        `;
      }).join("");
    }

    // --- USE CASE 2 AUDITOR FUNCTIONS ---
    async function loadRawResumes() {
      if (rawResumes.length > 0) return;
      const res = await fetch("/api/auditor/raw-resumes");
      rawResumes = await res.json();

      const pillsContainer = document.getElementById("rawCandPills");
      pillsContainer.innerHTML = rawResumes.map(r => `
        <button id="pill_${r.id}" onclick="runAudit('${r.id}')"
          class="px-3 py-1.5 rounded-lg bg-slate-700 hover:bg-slate-600 text-white text-xs font-medium transition border border-transparent">
          ${r.name}
        </button>
      `).join("");

      if (rawResumes.length > 0) {
        runAudit(rawResumes[0].id);
      }
    }

    async function runAudit(id) {
      rawResumes.forEach(r => {
        const btn = document.getElementById(`pill_${r.id}`);
        if (btn) {
          if (r.id === id) {
            btn.className = "px-3 py-1.5 rounded-lg bg-indigo-600 text-white text-xs font-medium transition border border-indigo-400 shadow";
          } else {
            btn.className = "px-3 py-1.5 rounded-lg bg-slate-700 hover:bg-slate-600 text-white text-xs font-medium transition border border-transparent";
          }
        }
      });

      const selected = rawResumes.find(r => r.id === id);
      if (!selected) return;

      document.getElementById("rawCandTag").innerText = selected.id;
      document.getElementById("flawBanner").innerText = `Test Flaw Context: ${selected.missing_flaw}`;
      document.getElementById("rawResumeDisplay").innerText = selected.raw_text.trim();
      document.getElementById("missingInfoList").innerHTML = `<p class="text-xs text-slate-500 italic">Agent inspecting resume gaps...</p>`;
      document.getElementById("questionsList").innerHTML = "";

      const res = await fetch(`/api/auditor/audit/${id}`, { method: "POST" });
      const data = await res.json();
      const report = data.report;

      // Completeness Badge
      const scoreBadge = document.getElementById("completenessBadge");
      scoreBadge.innerText = `Completeness: ${report.completeness_score}/100`;
      scoreBadge.className = report.completeness_score >= 70
        ? "text-xs font-bold px-3 py-1 rounded-full border bg-amber-900/40 text-amber-300 border-amber-800"
        : "text-xs font-bold px-3 py-1 rounded-full border bg-rose-900/40 text-rose-300 border-rose-800";

      // Missing Critical Information
      document.getElementById("missingInfoList").innerHTML = report.missing_critical_info.map(m => `
        <div class="p-2.5 bg-rose-950/30 border border-rose-900/50 rounded-lg text-xs">
          <div class="flex items-center justify-between">
            <span class="font-bold text-rose-400">[${m.category}]</span>
            <span class="text-[10px] uppercase font-mono px-1.5 py-0.5 rounded bg-rose-900/50 text-rose-300">${m.severity}</span>
          </div>
          <p class="text-slate-300 mt-1">${m.detail}</p>
        </div>
      `).join("");

      // Generated Screening Questions
      document.getElementById("questionsList").innerHTML = report.generated_screening_questions.map((q, idx) => `
        <div class="p-3 bg-slate-900 border border-slate-750 rounded-lg text-xs">
          <div class="flex items-center gap-2 mb-1">
            <span class="w-5 h-5 rounded-full bg-indigo-900/60 text-indigo-300 font-bold flex items-center justify-center text-[10px]">
              Q${idx + 1}
            </span>
            <span class="font-semibold text-indigo-300">${q.topic}</span>
          </div>
          <p class="text-slate-200 mt-1">${q.question}</p>
          <p class="text-slate-400 mt-1.5"><span class="text-slate-500">Recruiter Rationale:</span> ${q.rationale}</p>
        </div>
      `).join("");
    }

    // --- PDF EXPORT (AUTO-TABLE) ---
    function downloadRankedPDF() {
      if (!currentRankings || currentRankings.length === 0) {
        alert("No ranked candidates to download.");
        return;
      }

      const jsPdfConstructor = (window.jspdf && window.jspdf.jsPDF) || window.jsPDF;
      if (!jsPdfConstructor) {
        alert("PDF generator library is not ready. Please refresh.");
        return;
      }

      const doc = new jsPdfConstructor({ orientation: "portrait", unit: "pt", format: "a4" });
      const selectedJobId = document.getElementById("jobSelect").value;
      const selectedJob = allJobs.find(j => j.id === selectedJobId);
      const jobTitle = selectedJob ? selectedJob.title : "Target Role";

      doc.setFont("helvetica", "bold");
      doc.setFontSize(18);
      doc.setTextColor(30, 41, 59);
      doc.text("TalentVector AI - Candidate Ranking Report", 40, 45);

      doc.setFontSize(10);
      doc.setFont("helvetica", "normal");
      doc.setTextColor(100, 116, 139);
      doc.text(`Target Role: ${jobTitle} (${selectedJobId})`, 40, 65);
      doc.text(`Generated: ${new Date().toLocaleString()} | Candidates: ${currentRankings.length}`, 40, 80);

      const tableHeaders = [["Rank", "Candidate Name", "Current Title", "Match %", "Verdict", "Cosine"]];
      const tableRows = currentRankings.map((item, idx) => [
        `#${idx + 1}`,
        item.candidate.name,
        item.candidate.current_title,
        `${item.match_percentage}%`,
        item.verdict,
        Number(item.raw_cosine).toFixed(3)
      ]);

      doc.autoTable({
        startY: 95,
        head: tableHeaders,
        body: tableRows,
        theme: "grid",
        headStyles: { fillColor: [30, 41, 59], textColor: [255, 255, 255], fontStyle: "bold", fontSize: 9 },
        bodyStyles: { textColor: [51, 65, 85], fontSize: 8.5, cellPadding: 6 },
        columnStyles: {
          0: { cellWidth: 40, halign: "center" },
          1: { cellWidth: 120, fontStyle: "bold" },
          2: { cellWidth: 140 },
          3: { cellWidth: 60, halign: "center" },
          4: { cellWidth: 90, halign: "center" },
          5: { cellWidth: 55, halign: "center" },
        }
      });

      doc.save(`Candidate_Rankings_${selectedJobId}_${Date.now()}.pdf`);
    }

    // Modal & Action Handlers
    function openUploadModal() { document.getElementById("uploadModal").classList.remove("hidden"); }
    function closeUploadModal() {
      document.getElementById("uploadModal").classList.add("hidden");
      document.getElementById("uploadForm").reset();
      document.getElementById("selectedFileLabel").innerText = "Choose a .pdf file";
    }
    function updateFileName(input) {
      if (input.files.length > 0) document.getElementById("selectedFileLabel").innerText = input.files[0].name;
    }

    async function handleResumeUpload(e) {
      e.preventDefault();
      const fileInput = document.getElementById("resumeFileInput");
      if (!fileInput.files.length) return;

      const formData = new FormData();
      formData.append("file", fileInput.files[0]);
      formData.append("name", document.getElementById("uploadName").value);
      formData.append("title", document.getElementById("uploadTitle").value);

      const btn = document.getElementById("uploadSubmitBtn");
      btn.innerText = "Extracting PDF...";
      btn.disabled = true;

      try {
        const res = await fetch("/api/upload-pdf-resume", { method: "POST", body: formData });
        const result = await res.json();
        if (!res.ok) throw new Error(result.detail || "Upload failed");
        closeUploadModal();
        await runMatch();
      } catch (err) {
        alert(err.message);
      } finally {
        btn.innerText = "Extract & Ingest";
        btn.disabled = false;
      }
    }

    function openEditModal(candId) {
      const match = currentRankings.find(r => r.candidate.id === candId);
      if (!match) return;
      const c = match.candidate;
      document.getElementById("editCandId").value = c.id;
      document.getElementById("editName").value = c.name;
      document.getElementById("editTitle").value = c.current_title;
      document.getElementById("editSkills").value = c.skills;
      document.getElementById("editSummary").value = c.summary;
      document.getElementById("editModal").classList.remove("hidden");
    }
    function closeEditModal() { document.getElementById("editModal").classList.add("hidden"); }

    async function saveCandidateEdit() {
      const candId = document.getElementById("editCandId").value;
      const payload = {
        name: document.getElementById("editName").value.trim(),
        current_title: document.getElementById("editTitle").value.trim(),
        skills: document.getElementById("editSkills").value.trim(),
        summary: document.getElementById("editSummary").value.trim(),
      };
      await fetch(`/api/resumes/${candId}`, {
        method: "PUT",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload)
      });
      closeEditModal();
      runMatch();
    }

    async function deleteCandidate(candId) {
      if (!confirm(`Delete profile ${candId}?`)) return;
      await fetch(`/api/resumes/${candId}`, { method: "DELETE" });
      runMatch();
    }

    function openJobModal() { document.getElementById("jobModal").classList.remove("hidden"); }
    function closeJobModal() { document.getElementById("jobModal").classList.add("hidden"); }

    async function submitNewJob() {
      const id = document.getElementById("newId").value.trim();
      const title = document.getElementById("newTitle").value.trim();
      const skills = document.getElementById("newSkills").value.trim();
      const summary = document.getElementById("newSummary").value.trim();
      if (!id || !title) return alert("Please provide ID and Title");

      await fetch("/api/jobs", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ id, title, skills, summary })
      });
      closeJobModal();
      await init();
      document.getElementById("jobSelect").value = id;
      runMatch();
    }

    window.onload = init;
  </script>
</body>

</html>